{
	"name": "CalmStart",
	"short_name": "CalmStart",
	"version": "1.1.1",
	"minimum_chrome_version": "104",
	"manifest_version": 3,
	"description": "A calm, customizable new tab page with bookmarks, flexible columns, and browser sync.",
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"permissions": [
		"bookmarks",
		"favicon",
		"topSites",
		"tabs",
		"fontSettings",
		"sessions",
		"storage"
	],
	"optional_host_permissions": [
		"file:///"
	],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	}
}
